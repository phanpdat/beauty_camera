<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.MainActivity">

    <!-- Camera qua OpenGL -->
    <com.example.beauty_cameracamera_app.gl.CameraGLView
        android:id="@+id/cameraGLView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Nút chụp ảnh (giữa dưới) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingBottom="100dp">

        <View
            android:id="@+id/btnCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/capture_button" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="170dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="#44000000"
        android:padding="16dp"
        android:orientation="vertical">


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Cằm (Chin) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Gọt Cằm"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/chinSlimmingSeekBar"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50"
                        android:thumbTint="#E91E63"
                        android:progressTint="#E91E63" />
                </LinearLayout>

                <!-- 2. Mũi (Nose) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Nâng Mũi"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/noseSlimmingSeekBar"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50"
                        android:thumbTint="#FF9800"
                        android:progressTint="#FF9800" />
                </LinearLayout>

                <!-- 3. Mắt (Eye) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Mắt To"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/eyeSizeSeekBar"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="0"
                        android:thumbTint="#2196F3"
                        android:progressTint="#2196F3" />
                </LinearLayout>

                <!-- 4. Môi (Lip) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Môi Mọng"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/lipSizeSeekBar"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50"
                        android:thumbTint="#4CAF50"
                        android:progressTint="#4CAF50" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Vạch ngăn cách -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"/>

        <!-- Điều khiển độ mạnh Filter Màu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="Màu Filter"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/intensitySeekBar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="80"
                android:thumbTint="#FFFFFF"
                android:progressTint="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

    <!-- Thanh filter cuộn ngang -->
    <HorizontalScrollView
        android:id="@+id/filterScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        tools:ignore="SpeakableTextPresentCheck">

        <LinearLayout
            android:id="@+id/filterContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

    </HorizontalScrollView>

</FrameLayout>